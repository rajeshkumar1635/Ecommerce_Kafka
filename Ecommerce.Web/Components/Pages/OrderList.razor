@page "/orders"
@using Ecommerce.model
@inject HttpClient Http
<h3>Orders</h3>
<table class="table">
    <thead>
        <tr>
            <th>
                Customer Name
            </th>
            <th>
                ProductId
            </th>
            <th>
                Quantity
            </th>
            <th>
               OrderDate
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach(var order in Orders)
        {
            <tr>
                <td>
                    @order.CustomerName
                </td>
                <td>
                    @order.ProductId
                </td>
                <td>
                    @order.Quantity
                </td>
                <td>
                    @order.OrderDate
                </td>
            </tr>
        }
    </tbody>
</table>


@code {
    private List<OrderModel> Orders = new();
    protected override async Task OnInitializedAsync()
    {
        Orders = await Http.GetFromJsonAsync<List<OrderModel>>("https://localhost:7233/api/order");
        await base.OnInitializedAsync();
    }

}
